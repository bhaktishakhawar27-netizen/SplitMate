<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F7"
    android:fillViewport="true"
        android:fadeScrollbars="true"
        android:scrollbarStyle="insideOverlay"
        android:scrollbarThumbVertical="@drawable/scrollbar_thumb">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Split Bill 🤝"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#202124" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Split expenses and know who owes whom."
            android:textSize="14sp"
            android:textColor="#6B7275"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="28dp" />


        <!-- AMOUNT -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOTAL BILL"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#202124" />

        <EditText
            android:id="@+id/amountEditText"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="₹ 0.00"
            android:inputType="numberDecimal"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="14dp"
            android:backgroundTint="#5EEAD4"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="18dp" />


        <!-- DESCRIPTION -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DESCRIPTION"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#202124" />

        <EditText
            android:id="@+id/descriptionEditText"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="e.g. Dinner at FC Road"
            android:textSize="15sp"
            android:padding="14dp"
            android:backgroundTint="#AEB5B7"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="18dp" />


        <!-- PAID BY -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAID BY"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#202124" />

        <EditText
            android:id="@+id/paidByEditText"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="e.g. Bhakti"
            android:textSize="15sp"
            android:padding="14dp"
            android:backgroundTint="#AEB5B7"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="18dp" />


        <!-- MEMBERS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MEMBERS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#202124" />

        <EditText
            android:id="@+id/membersEditText"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:hint="Aditi, Bhakti, Rahul, Sneha"
            android:gravity="top"
            android:textSize="15sp"
            android:padding="14dp"
            android:backgroundTint="#AEB5B7"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="18dp" />


        <!-- EXCLUDE ME -->

        <CheckBox
            android:id="@+id/excludeMeCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exclude Me (my share is not deducted from my balance)"
            android:textSize="14sp"
            android:textColor="#202124"
            android:buttonTint="#238F83"
            android:layout_marginBottom="18dp" />


        <!-- SPLIT TYPE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SPLIT TYPE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#202124" />

        <Spinner
            android:id="@+id/splitTypeSpinner"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="18dp" />


        <!-- VALUES -->

        <EditText
            android:id="@+id/valuesEditText"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:hint="Only for Custom / Percentage"
            android:textSize="15sp"
            android:padding="14dp"
            android:backgroundTint="#AEB5B7"
            android:inputType="text"
            android:digits="0123456789., "
            android:layout_marginBottom="22dp" />


        <!-- CALCULATE -->

        <Button
            android:id="@+id/calculateButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="CALCULATE SPLIT  →"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#202124"
            android:backgroundTint="#5EEAD4" />


        <!-- RESULT -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settlement"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#202124"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your settlement will appear here."
            android:textSize="16sp"
            android:textColor="#202124"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp" />

        <!-- PAID / NOT PAID STATUS (filled in after CALCULATE) -->

        <LinearLayout
            android:id="@+id/settlementContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="30dp" />

    </LinearLayout>

</ScrollView>