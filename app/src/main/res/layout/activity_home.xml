<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAIN SCREEN CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F7F7"
        android:fillViewport="true"
        android:fadeScrollbars="true"
        android:scrollbarStyle="insideOverlay"
        android:scrollbarThumbVertical="@drawable/scrollbar_thumb">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="18dp">

            <!-- MENU -->
            <TextView
                android:id="@+id/menuButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="☰"
                android:textSize="27sp"
                android:textColor="#202124"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <!-- USER ACCOUNT -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:id="@+id/userNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hello"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#202124" />

                <TextView
                    android:id="@+id/userEmailText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="user@email.com"
                    android:textSize="13sp"
                    android:textColor="#6B7275"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SplitMate"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="#202124" />

                <TextView
                    android:id="@+id/greetingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hello 👋"
                    android:textSize="14sp"
                    android:textColor="#6B7275"
                    android:layout_marginTop="3dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- MONTHLY BUDGET -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#202124"
            android:padding="20dp"
            android:layout_marginTop="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MONTHLY BUDGET"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#9EA4A6" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginTop="5dp">

                <TextView
                    android:id="@+id/budgetText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹5000"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="#5EEAD4"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  ✏️"
                    android:textSize="16sp"
                    android:layout_marginStart="2dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/budgetDateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="September 2026"
                android:textSize="13sp"
                android:textColor="#D9F9F3"
                android:layout_marginTop="5dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- QUICK ACTIONS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Actions"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#202124"
            android:layout_marginTop="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/expenseButton"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="＋ Expense"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#202124"
                android:backgroundTint="#5EEAD4" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/groupsButton"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:text="⇄ Split Bill"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#202124"
                android:backgroundTint="#D9F9F3" />

        </LinearLayout>

        <!-- SPENT / BALANCE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPENT THIS MONTH"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#6B7275" />

                <TextView
                    android:id="@+id/spentText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#202124"
                    android:layout_marginTop="5dp" />

            </LinearLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BALANCE LEFT"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#6B7275" />

                <TextView
                    android:id="@+id/balanceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹5000"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#238F83"
                    android:layout_marginTop="5dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- PIE CHART -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Where your money goes"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#202124"
            android:layout_marginTop="25dp" />

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/spendingPieChart"
            android:layout_width="match_parent"
            android:layout_height="310dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF" />

        <!-- SPENDING -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="25dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Spending"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#202124" />

            <TextView
                android:id="@+id/viewAllCategoriesText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap amount for details"
                android:textSize="11sp"
                android:textColor="#6B7275" />

        </LinearLayout>

        <!-- FOOD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍔  Food"
                android:textSize="15sp"
                android:textColor="#202124" />

            <TextView
                android:id="@+id/foodAmountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#202124"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- CANTEEN -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:layout_marginTop="5dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍱  Canteen"
                android:textSize="15sp"
                android:textColor="#202124" />

            <TextView
                android:id="@+id/canteenAmountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#202124"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- TRAVEL -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:layout_marginTop="5dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🚌  Travel"
                android:textSize="15sp"
                android:textColor="#202124" />

            <TextView
                android:id="@+id/travelAmountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#202124"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- SHOPPING -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:layout_marginTop="5dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🛍  Shopping"
                android:textSize="15sp"
                android:textColor="#202124" />

            <TextView
                android:id="@+id/shoppingAmountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#202124"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- EDUCATION -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:layout_marginTop="5dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📚  Education"
                android:textSize="15sp"
                android:textColor="#202124" />

            <TextView
                android:id="@+id/educationAmountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#202124"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- ENTERTAINMENT -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:layout_marginTop="5dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎬  Entertainment"
                android:textSize="15sp"
                android:textColor="#202124" />

            <TextView
                android:id="@+id/entertainmentAmountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#202124"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- BILLS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:layout_marginTop="5dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💡  Bills"
                android:textSize="15sp"
                android:textColor="#202124" />

            <TextView
                android:id="@+id/billsAmountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#202124"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- OTHER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:layout_marginTop="5dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📦  Other"
                android:textSize="15sp"
                android:textColor="#202124" />

            <TextView
                android:id="@+id/otherAmountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#202124"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- SMART MONEY CHECK -->

        <Button
            android:id="@+id/smartTipButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="💡  Smart Money Check"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#202124"
            android:backgroundTint="#D9F9F3"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="25dp" />

    </LinearLayout>

    </ScrollView>

    <!-- LEFT SIDE DRAWER (PhonePe style) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        app:headerLayout="@layout/nav_header_home"
        app:menu="@menu/menu_drawer"
        app:itemIconTint="#202124"
        app:itemTextColor="#202124" />

</androidx.drawerlayout.widget.DrawerLayout>